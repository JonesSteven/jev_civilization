# Copy to .env.local and fill in. Never commit real credentials.
# Server-only secret for the TypeSafe direct API (Jev). Must NOT have a NEXT_PUBLIC_ prefix.
TYPESAFE_API_KEY=
# Pinned model ID. The model actually used is recorded per turn from the response.
JEV_MODEL=jev-1.13.0
# Local SQLite file on a persistent, writable volume.
DATABASE_PATH=./data/jevciv.sqlite
# Explicitly labeled mock simulation for keyless development and tests. Defaults to false in production.
ALLOW_MOCK_MODE=false
# Per-attempt Jev timeout (ms), total automatic attempts per turn, per-game attempt budget, process concurrency.
JEV_TIMEOUT_MS=10000
JEV_MAX_ATTEMPTS_PER_TURN=3
JEV_MAX_ATTEMPTS_PER_GAME=300
JEV_MAX_CONCURRENCY=4
# Public origin used to validate mutation requests (scheme://host[:port], no trailing slash).
APP_ORIGIN=http://localhost:3000
# Disable framework telemetry.
NEXT_TELEMETRY_DISABLED=1
# Optional local abuse limits (defaults: 60 turn starts/minute and 10 new games/hour per session).
# RATE_LIMIT_TURNS_PER_MINUTE=60
# RATE_LIMIT_GAMES_PER_HOUR=10
