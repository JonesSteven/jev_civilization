{
  "name": "jev-civilizations",
  "version": "1.0.0",
  "description": "Autonomous tribes decided by the Jev model while you shape the environment \u2014 a Next.js civilization simulation demo.",
  "license": "MIT",
  "author": "Steven Jones",
  "repository": {
    "type": "git",
    "url": "https://github.com/JonesSteven/jevcivdemo.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate:catalog && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate:catalog": "tsx scripts/validate-catalog.ts",
    "simulate": "tsx scripts/simulate.ts",
    "probe:jev": "tsx scripts/probe-jev.ts",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "notices": "tsx scripts/third-party-notices.ts"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.6",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
